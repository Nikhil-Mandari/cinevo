# CINÉVO frontend environment
# Leave VITE_API_BASE_URL empty to run entirely on the local mock service layer.
# Point it at the future Java Spring Boot API to switch the service modules to REST.
VITE_API_BASE_URL=
VITE_USE_MOCK_API=true
VITE_APP_NAME=CINÉVO
# JWT storage key used by authService once the Spring Boot API is live.
VITE_AUTH_TOKEN_KEY=cinevo.jwt
